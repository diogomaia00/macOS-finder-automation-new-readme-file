				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string># Receives files/folders (right-click) or nothing (keyboard shortcut).
if [ $# -eq 0 ]; then
  d=$(osascript -e 'tell application "Finder"
    if (count of Finder windows) &gt; 0 then
      return POSIX path of (target of front Finder window as alias)
    else
      return POSIX path of (path to desktop folder)
    end if
  end tell')
  set -- "$d"
fi
for f in "$@"; do
  if [ -d "$f" ]; then d="$f"; else d=$(dirname "$f"); fi
  target="${d%/}/README.md"
  [ -e "$target" ] || : &gt; "$target"
done
</string>
					<key>CheckedForUserDefaultShell</key>
